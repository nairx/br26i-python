   "source": [
    "#Reinforcement Learning\n",
    "position=0\n",
    "while position < 5:\n",
    "    print(f\"Current position: \",position)\n",
    "    action=input(\"Move right?(y/n): \")\n",
    "    if action == \"y\":\n",
    "        position += 1\n",
    "        reward=1\n",
    "    else:\n",
    "        reward =-1\n",
    "print(\"Goal reached!\")"
   ]
